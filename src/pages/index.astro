---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import NewsletterForm from '../components/NewsletterForm.jsx';
import TourWidget from '../components/TourWidget.jsx';

// Fetch directly from our new serverless API endpoint
const response = await fetch(new URL('/api/tour-dates', Astro.url).href);
const tourDates = await response.json();
---

<Layout title="SENTIENT | Official Website">
  <main class="max-w-4xl mx-auto px-6 py-24 min-h-screen flex flex-col justify-between">
    
    <!-- Hero Header Component -->
    <header class="text-center my-auto flex flex-col items-center w-full max-w-lg mx-auto">
      
      <!-- Responsive Logo Canvas Container -->
      <div class="w-full max-w-xs md:max-w-md fill-current text-foreground mb-4">
        <Logo />
      </div>

      <div class="h-1 w-24 bg-primary mb-12"></div>
      
      <!-- External Streaming Links Box -->
      <div class="flex gap-8 text-xs tracking-[0.15em] uppercase font-bold text-zinc-400">
        <a href="https://open.spotify.com/artist/18Il5iIPhP7qP2hnVlYtxW" target="_blank" rel="noopener" class="hover:text-primary transition-colors duration-300">Spotify</a>
        <a href="https://music.apple.com/us/artist/sentient/6814596372" target="_blank" rel="noopener" class="hover:text-primary transition-colors duration-300">Apple Music</a>
        <a href="https://sentientwave.bandcamp.com/" target="_blank" rel="noopener" class="hover:text-primary transition-colors duration-300">Bandcamp</a>
      </div>

      <nav aria-label="Social media" class="mt-6 flex items-center gap-8 text-zinc-400">
        <a
          href="https://www.instagram.com/sentient423/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sentient on Instagram"
          class="transition-colors duration-300 hover:text-primary"
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.facebook.com/people/Sentient-All-synths-makes-sense/61591714753325/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sentient on Facebook"
          class="transition-colors duration-300 hover:text-primary"
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.4 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.2V13H10v8h3.4Z" />
          </svg>
        </a>
      </nav>
    </header>

    <!-- Mailing List Signup Section -->
    <section class="w-full mt-24">
      <h2 class="font-display text-xl uppercase tracking-widest text-primary mb-6">Join the Mailing List</h2>
      <NewsletterForm client:load />
    </section>

    <!-- Basic Tour Dates Display Area -->
    <section class="w-full mt-24">
      <h2 class="font-display text-xl uppercase tracking-widest text-primary mb-6">Upcoming Shows</h2>

      <!-- client:load hydrates this component, making it instantly interactive for search/filters -->
      <TourWidget client:load dates={tourDates} />

<!-- Use  mock data to verify your frontend layout engine works

      <div class="bg-surface border border-accent/20 rounded-lg p-6 divide-y divide-accent/10">
        {mockTourDates.map((show) => (
          <div class="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="text-primary font-mono text-sm uppercase tracking-wider font-semibold">{show.date}</p>
              <h3 class="text-xl font-bold tracking-tight text-foreground">{show.venue}</h3>
              <p class="text-sm text-zinc-400">{show.city}</p>
            </div>
            <a href={show.ticketLink} class="bg-primary hover:bg-accent text-foreground font-bold tracking-wider uppercase text-xs px-6 py-3 rounded transition-colors duration-300 text-center sm:w-auto w-full">
              Tickets
            </a>
          </div>
        ))}
      </div>

-->

    </section>
  </main>
</Layout>
