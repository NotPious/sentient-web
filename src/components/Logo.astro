---
// We fetch the raw SVG text data dynamically during the static build phase
import fs from 'node:fs';
import path from 'node:path';

const logoPath = path.join(process.cwd(), 'src', 'styles', 'redblack.svg');
const rawLogoSvg = fs.readFileSync(logoPath, 'utf-8');

// Strip out any hardcoded XML document declarations or fixed pixel dimensions 
// to make the string safe to pass as clean responsive HTML output strings
const logoSvg = rawLogoSvg
  .replace(/<\?xml.*?\?>/g, '')
  .replace(/<!DOCTYPE.*?>/g, '')
  .replace(/<!--.*?-->/gs, '')
  .replace(/width="\d+"/, 'width="100%"')
  .replace(/height="\d+"/, 'height="100%"');
---

<Fragment set:html={logoSvg} />
